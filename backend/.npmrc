# No ejecutar scripts de instalación de las dependencias. better-sqlite3 trae binarios precompilados
# (N-API) para Windows, macOS y Linux; sin esto, npm deduce un `node-gyp rebuild` por su binding.gyp
# que exige herramientas de compilación (Visual Studio Build Tools / Python) y falla sin ellas.
# No afecta a `npm run dev|build|test`.
ignore-scripts=true
